<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.classtechstar.hspcb"
    android:versionCode="11"
    android:versionName="1.9.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- WebView 拦截式资产域不实际出网；声明以便 WebView 内核正常初始化 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v1.8.1 检查更新：仅经 GitHub/Gitee 只读 GET 拉取版本与 APK（无用户数据上传） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:supportsRtl="true">

        <!-- 更新 APK 的 content:// 提供器（不可导出，安装器经临时读授权访问） -->
        <provider
            android:name=".MiniFileProvider"
            android:authorities="com.classtechstar.hspcb.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
