{
  "name": "hspcb-study-bundle",
  "version": "1.3.0",
  "private": true,
  "description": "高中物化生语数英学习大礼包 — 广东高考智能备考平台（纯静态）",
  "type": "module",
  "scripts": {
    "serve": "python -m http.server 8000 --directory 1.2",
    "check:data": "node scripts/validate-data.mjs",
    "check:data:json": "node scripts/validate-data.mjs --json",
    "check:collisions": "node scripts/check-global-collisions.mjs",
    "test": "node scripts/test-progress.mjs && node scripts/test-cross-subject.mjs",
    "test:smoke": "node scripts/smoke-app.mjs",
    "verify": "npm run check:data && npm run check:collisions && npm run check:theme && npm run check:csp && npm run check:lint && npm run check:content && npm run check:runtime && npm run test && npm run test:smoke",
    "check:runtime": "node scripts/runtime-defer-check.mjs",
    "check:lint": "node scripts/check-lint.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "check:csp": "node scripts/check-csp-inline.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "CC-BY-NC-SA-4.0"
}
